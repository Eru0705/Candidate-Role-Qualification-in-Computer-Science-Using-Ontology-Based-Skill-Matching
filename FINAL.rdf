    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#BackendDeveloper -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#BackendDeveloper">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#Role"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresTechnicalSkill"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#API"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresTechnicalSkill"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Backend"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresTechnicalSkill"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Database"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresTechnicalSkill"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#ProgrammingLanguage"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresSoftSkill"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#SoftSkill"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#DevelopmentJobQualified"/>
    </owl:Class>
    


