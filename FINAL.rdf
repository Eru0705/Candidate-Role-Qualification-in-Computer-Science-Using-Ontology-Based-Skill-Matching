<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/user/ontologies/2026/3/Final/"
     xml:base="http://www.semanticweb.org/user/ontologies/2026/3/Final/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:Final="http://www.semanticweb.org/user/ontologies/2026/3/Final#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#hasSoftSkill -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#hasSoftSkill">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#isSoftSkillOf"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#SoftSkill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#hasTechnicalSkill -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#hasTechnicalSkill">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#isTechnicalSkillOf"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#TechnicalSkill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#isRequiredSoftSkillOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#isRequiredSoftSkillOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresSoftSkill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#isRequiredTechnicalSkillOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#isRequiredTechnicalSkillOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresTechnicalSkill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#isSoftSkillOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#isSoftSkillOf"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#isTechnicalSkillOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#isTechnicalSkillOf"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#qualifiedfor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#qualifiedfor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Candidate"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Role"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#hasSoftSkill"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#isRequiredSoftSkillOf"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#hasTechnicalSkill"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#isRequiredTechnicalSkillOf"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresSoftSkill -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresSoftSkill">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Role"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#SoftSkill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresTechnicalSkill -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresTechnicalSkill">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Role"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#TechnicalSkill"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#hasYearsOfExperience -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#hasYearsOfExperience">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Candidate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresYearsOfExperience -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#requiresYearsOfExperience">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Role"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#AI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#AI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#TechnicalSkill"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#AIJobQualified -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#AIJobQualified">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#Role"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#ComputerVisionEngineer"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#LLMEngineer"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#MachineLearningEngineer"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/3/Final#Role"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/3/Final#API -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/3/Final#API">
